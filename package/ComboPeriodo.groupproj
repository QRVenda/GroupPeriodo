<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ProjectGuid>{AA333361-8281-40AA-A21C-D09A4636F17D}</ProjectGuid>
    </PropertyGroup>
    <ItemGroup>
        <Projects Include="GroupPeriodo.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="..\Demo\Testar.dproj">
            <Dependencies/>
        </Projects>
    </ItemGroup>
    <ProjectExtensions>
        <Borland.Personality>Default.Personality.12</Borland.Personality>
        <Borland.ProjectType/>
        <BorlandProject>
            <Default.Personality/>
        </BorlandProject>
    </ProjectExtensions>
    <Target Name="GroupPeriodo">
        <MSBuild Projects="GroupPeriodo.dproj"/>
    </Target>
    <Target Name="GroupPeriodo:Clean">
        <MSBuild Projects="GroupPeriodo.dproj" Targets="Clean"/>
    </Target>
    <Target Name="GroupPeriodo:Make">
        <MSBuild Projects="GroupPeriodo.dproj" Targets="Make"/>
    </Target>
    <Target Name="Testar">
        <MSBuild Projects="..\Demo\Testar.dproj"/>
    </Target>
    <Target Name="Testar:Clean">
        <MSBuild Projects="..\Demo\Testar.dproj" Targets="Clean"/>
    </Target>
    <Target Name="Testar:Make">
        <MSBuild Projects="..\Demo\Testar.dproj" Targets="Make"/>
    </Target>
    <Target Name="Build">
        <CallTarget Targets="GroupPeriodo;Testar"/>
    </Target>
    <Target Name="Clean">
        <CallTarget Targets="GroupPeriodo:Clean;Testar:Clean"/>
    </Target>
    <Target Name="Make">
        <CallTarget Targets="GroupPeriodo:Make;Testar:Make"/>
    </Target>
    <Import Project="$(BDS)\Bin\CodeGear.Group.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Group.Targets')"/>
</Project>
